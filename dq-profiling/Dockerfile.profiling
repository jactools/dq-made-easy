ARG PYTHON_DOCKER_REGISTRY=""
ARG PYTHON_DOCKER_NAMESPACE="jacbeekers/"
ARG PYTHON_DOCKER_IMAGE="dq-made-easy-python-base"
ARG PYTHON_DOCKER_TAG="latest"

FROM ${PYTHON_DOCKER_REGISTRY}${PYTHON_DOCKER_NAMESPACE}${PYTHON_DOCKER_IMAGE}:${PYTHON_DOCKER_TAG}

LABEL version="0.4.0"
LABEL description="Data profiling worker service (Python)"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST

COPY python/requirements.txt ./requirements.txt
RUN PIP_INDEX_URL="$PIP_INDEX_URL" PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" pip install --no-cache-dir -r requirements.txt

COPY python ./python

# Create non-root user and set ownership
RUN useradd --create-home --shell /bin/bash appuser && chown -R appuser:appuser /app
USER appuser

WORKDIR /app/python

CMD ["python", "-u", "queue_worker.py"]
