# syntax=docker/dockerfile:1.7
ARG PYTHON_DOCKER_REGISTRY
ARG PYTHON_DOCKER_NAMESPACE
ARG PYTHON_DOCKER_IMAGE
ARG PYTHON_DOCKER_TAG

FROM ${PYTHON_DOCKER_REGISTRY}${PYTHON_DOCKER_NAMESPACE}${PYTHON_DOCKER_IMAGE}:${PYTHON_DOCKER_TAG}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST

COPY dq-utils /app/dq-utils
COPY dq-domain-validation /workspace/tmp/dq-domain-validation
COPY dq-api/fastapi/requirements.txt /workspace/tmp/requirements.txt
RUN --mount=type=secret,id=pip_index_url \
    PIP_INDEX_URL="$(cat /run/secrets/pip_index_url)" PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
    pip install --no-cache-dir -r /workspace/tmp/requirements.txt && \
    PIP_INDEX_URL="$(cat /run/secrets/pip_index_url)" PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
    pip install --no-cache-dir --no-build-isolation -e /app/dq-utils
RUN --mount=type=secret,id=pip_index_url \
    PIP_INDEX_URL="$(cat /run/secrets/pip_index_url)" PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
    python -m pip wheel --no-build-isolation --no-deps --wheel-dir /workspace/tmp/wheels /workspace/tmp/dq-domain-validation && \
    pip install --no-cache-dir --no-index --no-deps /workspace/tmp/wheels/dq_made_easy_domain_validation-*.whl

COPY dq-api/fastapi /app
COPY docs/contracts/internal-api /app/docs/contracts/internal-api
COPY data_sources/contracts /app/data_sources/contracts

# Copy repo-level scripts (generator, helpers) into the image so the
# entrypoint can run the generator inside the container during startup.
COPY scripts /app/scripts
COPY dq-api/fastapi/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Create non-root user and set ownership
RUN useradd --create-home --shell /bin/bash appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 4010

# Entrypoint runs generator (inside container), alembic upgrade, and starts uvicorn
CMD ["sh", "-c", "/app/docker-entrypoint.sh"]
