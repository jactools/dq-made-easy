# syntax=docker/dockerfile:1.7
ARG PYTHON_DOCKER_REGISTRY=""
ARG PYTHON_DOCKER_NAMESPACE="jacbeekers/"
ARG PYTHON_DOCKER_IMAGE="dq-made-easy-python-base"
ARG PYTHON_DOCKER_TAG="latest"

FROM ${PYTHON_DOCKER_REGISTRY}${PYTHON_DOCKER_NAMESPACE}${PYTHON_DOCKER_IMAGE}:${PYTHON_DOCKER_TAG}

LABEL version="0.3.0"
LABEL description="Data Quality rule execution engine (Python/FastAPI)"

WORKDIR /app

ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG MAVEN_REPOSITORIES
ARG SKIP_SPARK_WARMUP=false
ARG MKCERT_ROOT_CA
ARG INTERNAL_ROOT_CA

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV SPARK_JARS_REPOSITORIES=${MAVEN_REPOSITORIES:-}
ENV MAVEN_REPOSITORIES=${MAVEN_REPOSITORIES:-}

# NOTE: build-essential, git, ca-certificates, default-jre-headless,
# and ca-certificates-java are provided by the python-base image.
# Import the corporate root CA from a build secret (not baked into the image).
RUN set -eux; \
	if [ -f /run/secrets/internal_corporate_root_ca ]; then \
		cp /run/secrets/internal_corporate_root_ca /usr/local/share/ca-certificates/internal-corporate-root-ca2.crt; \
	fi; \
	rm -f /usr/local/share/ca-certificates/internal-corporate-root-ca2.crt \
	&& update-ca-certificates --fresh

# Optionally import a mkcert root CA provided as a base64-encoded build-arg
RUN if [ -n "${MKCERT_ROOT_CA:-}" ] && [ -f "${MKCERT_ROOT_CA}" ]; then \
	echo "Importing mkcert root CA into system truststore"; \
	cp "${MKCERT_ROOT_CA}" /usr/local/share/ca-certificates/mkcert-rootCA.crt; \
	update-ca-certificates || true; \
	fi

RUN if [ -n "${INTERNAL_ROOT_CA:-}" ] && [ -f "${INTERNAL_ROOT_CA}" ]; then \
	echo "Importing internal root CA into system truststore"; \
	cp "${INTERNAL_ROOT_CA}" /usr/local/share/ca-certificates/internal-root-ca-2024.crt; \
	update-ca-certificates || true; \
	fi

# Create a dedicated non-root user and a project-local virtual environment.
RUN useradd --create-home --shell /bin/bash appuser \
	&& python -m venv ${VIRTUAL_ENV} \
	&& chown -R appuser:appuser /app ${VIRTUAL_ENV}

# NOTE: This Dockerfile lives in dq-engine, but the build context is the repository root.
# Copy shared utils package and install it (cached unless dq-utils changes)
COPY --chown=appuser:appuser dq-utils/ /app/dq-utils/

# Copy the engine source (cached unless dq-engine changes)
COPY --chown=appuser:appuser dq-engine/ /app/dq-engine/

# Install all dependencies
RUN --mount=type=secret,id=pip_index_url \
	PIP_INDEX_URL="$(cat /run/secrets/pip_index_url)" PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
	python -m pip install --no-cache-dir --upgrade pip \
	&& PIP_INDEX_URL="$(cat /run/secrets/pip_index_url)" PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
	python -m pip install --no-cache-dir -r /app/dq-engine/requirements.txt \
	&& PIP_INDEX_URL="$(cat /run/secrets/pip_index_url)" PIP_EXTRA_INDEX_URL="$PIP_EXTRA_INDEX_URL" PIP_TRUSTED_HOST="$PIP_TRUSTED_HOST" \
	python -m pip install --no-cache-dir --no-build-isolation -e /app/dq-utils

# Copy the warmup script
COPY --chown=appuser:appuser dq-engine/scripts/ /app/dq-engine/scripts/

# Optionally run the spark warmup script at build time (cached unless dq-engine or vendor changes)
RUN if [ "${SKIP_SPARK_WARMUP}" = "false" ]; then \
	chmod +x /app/dq-engine/scripts/warmup_spark.sh; \
	/app/dq-engine/scripts/warmup_spark.sh; \
	fi

USER appuser

WORKDIR /app/dq-engine

EXPOSE 8000

CMD ["uvicorn", "--app-dir", ".", "main:app", "--host", "0.0.0.0", "--port", "8000"]
